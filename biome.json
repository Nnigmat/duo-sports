{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": ["shared/**", "server/**", "web/src/**", "web/*.ts", ".storybook/**", "*.ts"]
	},
	"formatter": { "enabled": false },
	"assist": { "enabled": false },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": { "noArrayIndexKey": "off", "useIterableCallbackReturn": "off" },
			"style": { "noNonNullAssertion": "off", "noDescendingSpecificity": "off" },
			"a11y": {
				"useSemanticElements": "off",
				"noNoninteractiveTabindex": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["web/src/base.css"],
			"linter": { "rules": { "complexity": { "noImportantStyles": "off" } } }
		}
	]
}
