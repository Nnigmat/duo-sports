{
  "name": "duo-sport",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,server -c cyan,green \"vite --config web/vite.config.ts\" \"tsx watch server/index.ts\"",
    "build": "tsc --noEmit && vite build --config web/vite.config.ts",
    "create-user": "tsx server/createUser.ts",
    "link-user": "tsx server/linkUser.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run --project unit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:stories": "vitest run --project storybook"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "concurrently": "^10.0.6",
    "playwright": "^1.64.1",
    "storybook": "^10.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
